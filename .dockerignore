# Allowlist for the NestJS images: only the Nx workspace sources reach the daemon.
*
!package.json
!package-lock.json
!nx.json
!tsconfig.base.json
!apps/
!libs/

**/node_modules
**/dist
**/.nx
**/.swc
**/coverage
**/test-results
**/tmp
**/logs
**/*.md
**/*.pdf
**/*.docx
**/.env
**/.env.*
**/*.tsbuildinfo
