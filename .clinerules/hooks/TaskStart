#!/usr/bin/env bash
# CLINE hook: TaskStart
# Location: .clinerules/hooks/TaskStart — no extension, executable.
# Ported from local-context.sh (Claude Code SessionStart stdout → Cline contextModification).

INPUT=$(cat)

CTX="📋 Project Context"
CTX="$CTX
==="

# Git info
if git rev-parse --git-dir >/dev/null 2>&1; then
  BRANCH=$(git branch --show-current 2>/dev/null)
  STATUS=$(git status --short 2>/dev/null | wc -l)
  CTX="$CTX
Branch: $BRANCH ($STATUS uncommitted changes)"
fi

# Package managers
MANAGERS=""
[ -f "package-lock.json" ] && MANAGERS="$MANAGERS npm"
[ -f "yarn.lock" ] && MANAGERS="$MANAGERS yarn"
[ -f "pnpm-lock.yaml" ] && MANAGERS="$MANAGERS pnpm"
[ -n "$MANAGERS" ] && CTX="$CTX
Package managers:$MANAGERS"

# Rules & policy reminders
[ -f "AGENTS.md" ] && CTX="$CTX
Policy: AGENTS.md is active — HL7 FHIR International only, Belgian eHealth IG tools are BLOCKED (see .clinerules/hooks/PreToolUse)."

# Structure
CTX="$CTX
Structure:"
for DIR in backend frontend tasks specs examples .clinerules; do
  if [ -d "$DIR" ]; then
    COUNT=$(find "$DIR" -maxdepth 1 -type f 2>/dev/null | wc -l)
    CTX="$CTX
  $DIR/ ($COUNT files)"
  fi
done

jq -n --arg ctx "$CTX" '{cancel:false,contextModification:$ctx}'