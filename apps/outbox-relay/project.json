{
  "name": "outbox-relay",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/outbox-relay/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:outbox"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/outbox-relay",
        "main": "apps/outbox-relay/src/main.ts",
        "tsConfig": "apps/outbox-relay/tsconfig.app.json",
        "assets": []
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "outbox-relay:build"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/outbox-relay/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/outbox-relay/**/*.ts"
        ]
      }
    }
  }
}
