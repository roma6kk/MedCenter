meta {
  name: 4.7 Room usage
  type: http
  seq: 6
  tags: [
    ro-admin
  ]
}

get {
  url: {{baseUrl}}/api/v1/admin/rooms/{{roomId}}/usage
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar('roomId')) { bru.runner.skipRequest(); }
}

assert {
  res.status: eq 200
  res.body.inUse: isBoolean
  res.body.items: isArray
}

docs {
  Spec 4.7. ADMIN. The `Schedule`, `PractitionerRole` and `HealthcareService` references that keep the room busy (`inUse` is true exactly when 4.6 answers 409 `ROOM_IN_USE`), then its upcoming booked `Slot`s; `truncated` when the slot list was cut.
  `display` follows `Accept-Language` (en, else ru); whether a resource is active is `isActive`.
}
