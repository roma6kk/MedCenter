meta {
  name: 6.5 Doctor appointments
  type: http
  seq: 3
  tags: [
    ro-doctor
  ]
}

get {
  url: {{baseUrl}}/api/v1/doctor/appointments?page=1&pageSize=20
  body: none
  auth: inherit
}

params:query {
  ~from: 
  ~to: 
  ~status: booked
  ~patient: 
  page: 1
  pageSize: 20
}

script:post-response {
  if (res.status === 200 && res.body.items.length) {
    bru.setVar('doctorAppointmentId', res.body.items[0].id);
    if (!bru.getVar('patientId')) bru.setVar('patientId', res.body.items[0].patientId);
  }
}

assert {
  res.status: eq 200
  res.body.items: isArray
  res.body.meta.page: isNumber
  res.body.meta.totalItems: isNumber
}

docs {
  Spec 6.5. DOCTOR, scope `user/*.read`; appointments where the doctor is a participant. `from`/`to` are inclusive RFC 3339 date-times with a zone, or dates (a date is the whole clinic day in Europe/Minsk: `from` its first instant, `to` its last); `status` is one status or a comma list/repeat of `booked|cancelled|noshow|fulfilled` and `patient` a Patient id, both narrowing the list inside the doctor's own compartment (unknown status or malformed id -> 400 `VALIDATION_ERROR`). Stores `doctorAppointmentId` and, when not known yet, `patientId`.
}
