meta {
  name: 3b Doctor: 422 INVALID_ICD10_CODE (error example)
  type: http
  seq: 4
  tags: [
    e2e
    write
    errors
  ]
}

post {
  url: {{baseUrl}}/api/v1/encounters/{{e2eEncounterId}}/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{doctorToken}}
}

body:json {
  {
    "summary": "ОРВИ, течение лёгкое",
    "diagnoses": [
      {
        "code": "J06.9",
        "display": "ОРВИ"
      },
      {
        "code": "Z99.99",
        "display": "нет такого кода"
      }
    ],
    "recommendations": "Покой, обильное питьё, повторный осмотр через 5 дней",
    "observations": [
      {
        "codeSystem": "https://fhir.by/CodeSystem/nsi-observations",
        "code": "20006",
        "value": 36.6,
        "unit": "Cel"
      }
    ],
    "serviceRequests": [
      {
        "codeSystem": "https://fhir.by/CodeSystem/nsi-services",
        "code": "10007",
        "note": "ЭКГ при сохранении жалоб"
      }
    ],
    "medicationRequests": [
      {
        "atcCode": "J01FA10",
        "dosageText": "500 мг 1 раз в сутки, 3 дня"
      }
    ]
  }
}

script:pre-request {
  if (!bru.getVar('e2eEncounterId')) { bru.runner.skipRequest(); }
}

assert {
  res.status: eq 422
  res.body.errorCode: eq INVALID_ICD10_CODE
  res.body.status: eq 422
}

tests {
  test('details[] names diagnoses.1.code', function () {
    const fields = res.body.details.map(function (d) { return d.field; });
    expect(fields).to.include('diagnoses.1.code');
  });
}

docs {
  Error example for the catalogue: the code check precedes any write, so the encounter opened in step 3 stays open and step 4 can complete it. `details[]` names the offending field.
}
