meta {
  name: 2.2.10 Change own password
  type: http
  seq: 11
  tags: [
    write
    destructive
  ]
}

post {
  url: {{baseUrl}}/api/v1/me/password
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "{{changePasswordCurrent}}",
    "newPassword": "{{changePasswordNew}}"
  }
}

script:pre-request {
  // closes every session of the token owner: runs only when both passwords are set on purpose.
  if (!bru.getEnvVar('changePasswordCurrent') || !bru.getEnvVar('changePasswordNew')) { bru.runner.skipRequest(); }
}

assert {
  res.status: eq 204
}

docs {
  Spec 2.2.10. Any signed-in user changes their own password; every session is closed afterwards. Wrong current password -> 403 `FORBIDDEN` with `INVALID_PASSWORD` at the start of `message`. Skipped unless `changePasswordCurrent` and `changePasswordNew` are set.
}
