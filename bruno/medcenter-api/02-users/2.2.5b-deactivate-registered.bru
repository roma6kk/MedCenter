meta {
  name: 2.2.5 Deactivate registered user (cleanup)
  type: http
  seq: 7
  tags: [
    write
    crud-users
    role-admin
  ]
}

delete {
  url: {{baseUrl}}/api/v1/admin/users/{{registeredUserId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar('registeredUserId')) { bru.runner.skipRequest(); }
}

assert {
  res.status: eq 200
  res.body.isActive: eq false
}

docs {
  Cleanup of the account created by 2.2.6 (soft delete, the row and the HAPI Patient stay).
}
