meta {
  name: 7.3 Complete encounter
  type: http
  seq: 7
  tags: [
    write
    role-doctor
  ]
}

post {
  url: {{baseUrl}}/api/v1/encounters/{{openedEncounterId}}/complete
  body: json
  auth: inherit
}

body:json {
  {
    "summary": "ОРВИ, течение лёгкое",
    "diagnoses": [
      {
        "code": "J06.9",
        "display": "Острая инфекция верхних дыхательных путей неуточнённая",
        "verificationStatus": "confirmed"
      }
    ],
    "recommendations": "Покой, обильное питьё, повторный осмотр через 5 дней",
    "observations": [
      {
        "codeSystem": "https://fhir.by/CodeSystem/nsi-observations",
        "code": "20006",
        "value": 36.6,
        "unit": "Cel"
      }
    ],
    "serviceRequests": [
      {
        "codeSystem": "https://fhir.by/CodeSystem/nsi-services",
        "code": "10007",
        "note": "ЭКГ при сохранении жалоб"
      }
    ],
    "medicationRequests": [
      {
        "atcCode": "J01FA10",
        "dosageText": "500 мг 1 раз в сутки, 3 дня"
      }
    ]
  }
}

script:pre-request {
  if (!bru.getVar('openedEncounterId')) { bru.runner.skipRequest(); }
}

assert {
  res.status: eq 200
  res.body.status: eq finished
  res.body.diagnosisCodes: contains J06.9
}

docs {
  Spec 7.3. DOCTOR, scope `user/*.write`. One atomic body: `summary` (3..4000), `diagnoses[1..20]` (ICD-10 `code`, `display`, `verificationStatus`), `recommendations`, optional `observations` (UCUM `unit`), `serviceRequests`, `medicationRequests` (ATC), `emergencyReason`. Also sets the appointment to `fulfilled`. 422 `INVALID_ICD10_CODE` / `TERMINOLOGY_NOT_FOUND` with `details[{field,message}]`; a repeat -> 409 `ENCOUNTER_STATE_INVALID`.
}
