meta {
  name: 2.1.3 Token (authorization_code)
  type: http
  seq: 4
  tags: [
    oauth-manual
    write
  ]
}

post {
  url: {{baseUrl}}/oauth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: authorization_code
  code: {{authCode}}
  redirect_uri: {{oauthRedirectUri}}
  client_id: {{oauthClientId}}
  code_verifier: {{pkceVerifier}}
}

script:pre-request {
  if (!bru.getVar('pkceVerifier')) { bru.runner.skipRequest(); }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar('accessToken', res.body.access_token);
    if (res.body.refresh_token) bru.setEnvVar('refreshToken', res.body.refresh_token);
  }
}

assert {
  res.status: eq 200
  res.body.token_type: eq Bearer
  res.body.access_token: isString
  res.body.refresh_token: isString
  res.body.expires_in: eq 900
}

docs {
  Spec 2.1.3, form-urlencoded. Needs `{{authCode}}` (the `code` of the redirect, single use) and the `pkceVerifier` of the matching 2.1.2 request. On 200 the post-response script puts the tokens into `accessToken` / `refreshToken` (in memory). Errors: 400 `invalid_grant`, 401 `invalid_client`, 429 `RATE_LIMITED` (20/min).
}
