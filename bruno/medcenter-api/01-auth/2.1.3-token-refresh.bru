meta {
  name: 2.1.3 Token (refresh_token)
  type: http
  seq: 5
  tags: [
    oauth-manual
    write
  ]
}

post {
  url: {{baseUrl}}/oauth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{refreshToken}}
  client_id: {{oauthClientId}}
}

script:pre-request {
  if (!bru.getEnvVar('refreshToken')) { bru.runner.skipRequest(); }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar('accessToken', res.body.access_token);
    bru.setEnvVar('refreshToken', res.body.refresh_token);
  }
}

assert {
  res.status: eq 200
  res.body.access_token: isString
  res.body.refresh_token: isString
}

docs {
  Refresh rotation (TTL 14 d): the old refresh token stops working. A revoked or already rotated token answers 400 `invalid_grant`, never 401 (contract note R1).
}
