meta {
  name: 5.2.4 Delete schedule
  type: http
  seq: 13
  tags: [
    write
    crud-schedules
    role-admin
  ]
}

delete {
  url: {{baseUrl}}/api/v1/admin/schedules/{{newScheduleId}}
  body: json
  auth: inherit
}

body:json {
  {
    "cascade": true
  }
}

script:pre-request {
  if (!bru.getVar('newScheduleId')) { bru.runner.skipRequest(); }
}

assert {
  res.status: eq 200
  res.body.deactivated: isBoolean
}

docs {
  Spec 5.2.4. ADMIN. Body `{ "cascade": false }` by default. Answer 200 `{ "deactivated": boolean }`. Without slots -> `false`; with free slots only `cascade:true` -> `false` (slots removed), or `true` when the schedule is deactivated because appointments reference its slots; a `busy` slot always -> 409 `SCHEDULE_IN_USE`. A repeat is safe (200 `true`).
}
