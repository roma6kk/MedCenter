meta {
  name: 9.4 Audit log
  type: http
  seq: 4
  tags: [
    ro-admin
  ]
}

get {
  url: {{baseUrl}}/api/v1/admin/audit?page=1&pageSize=20
  body: none
  auth: inherit
}

params:query {
  ~from: 
  ~to: 
  ~entity: Patient
  ~userId: 
  ~action: login,login-failed,login-throttled,logout,session-idle
  page: 1
  pageSize: 20
}

assert {
  res.status: eq 200
  res.body.items: isArray
  res.body.meta.page: isNumber
  res.body.meta.totalItems: isNumber
}

tests {
  test('events carry the action and the resource', function () {
    if (res.body.items.length) {
      const e = res.body.items[0];
      const authActions = ['login', 'login-failed', 'login-throttled', 'logout', 'session-idle'];
      expect(['create', 'update', 'delete', 'read', 'denied', 'emergency-bypass', ...authActions]).to.include(e.action);
      if (!authActions.includes(e.action)) {
        expect(e.resourceType).to.be.a('string');
        expect(e.requestId).to.be.a('string');
      } else {
        expect(e.resourceType === null || typeof e.resourceType === 'string').to.equal(true);
        expect(e.requestId === null || typeof e.requestId === 'string').to.equal(true);
      }
    }
  });
}

docs {
  Spec 9.4. ADMIN. A date-only `from`/`to` is a calendar day of the clinic (Europe/Minsk). Filters `from`, `to`, `entity` (`Patient` or `Patient/123`), `userId`, `action`, `page`, `pageSize`. `action` is one or several actions (comma list `action=login,logout` or repeated `action=login&action=logout`, OR); an unknown value is 400 VALIDATION_ERROR; omitted means every action. Actions: create, update, delete, read, denied, emergency-bypass (`reason` only on the last), and the authentication events login, login-failed, login-throttled, logout, session-idle (`resourceType` and `requestId` may be null for these).
}
