# Copy to `.env` (git-ignored, never committed — AGENTS.md).
# Every key below is required somewhere in the stack; placeholders are for dev only.

# --- Infrastructure -------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
# Host port for PostgreSQL (in-network port is always 5432); change if 5432 is taken.
POSTGRES_PORT=5432

# --- BFF services (validated by libs/config env.schema) -------------------
NODE_ENV=development
PORT=3001
FHIR_BASE_URL=http://hapi:8080/fhir
FHIR_CLIENT_ID=medcenter-bff
FHIR_CLIENT_SECRET=change-me-fhir-client
JWT_JWKS_URI=https://api.medcenter.by/.well-known/jwks.json
JWT_ISSUER=https://api.medcenter.by
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://rabbitmq:5672
RATE_LIMIT_PER_MINUTE=120
# Optional upstream terminology service (local seed is the default, ADR-016):
# TERMINOLOGY_UPSTREAM_URL=https://nsi.example.by
