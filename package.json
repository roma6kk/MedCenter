{
  "name": "medcenter",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test:tools": "jest tools/",
    "lint:tools": "eslint --no-eslintrc -c tools/.eslintrc.golden.json tools --ext .ts",
    "seed:terminology": "TS_NODE_PROJECT=tsconfig.base.json ts-node tools/terminology-seed/seed-terminology.ts",
    "seed:demo": "TS_NODE_PROJECT=tsconfig.base.json ts-node -r tsconfig-paths/register tools/demo-seed/seed-demo.ts",
    "smoke:stack": "TS_NODE_PROJECT=tsconfig.base.json ts-node -r tsconfig-paths/register tools/stack-smoke/run-stack-smoke.ts",
    "stack:up": "docker compose up -d --wait",
    "stack:wait": "TS_NODE_PROJECT=tsconfig.base.json ts-node tools/stack-smoke/wait-for-stack.ts",
    "stack:down": "docker compose down -v"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^12.0.2",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "^21.0.0",
    "@nx/eslint-plugin": "^21.0.0",
    "@nx/jest": "^21.0.0",
    "@nx/js": "^21.0.0",
    "@nx/nest": "^21.0.0",
    "@nx/workspace": "^21.0.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "nx": "^21.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.1.4",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
